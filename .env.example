# Shisha Delivery Platform - Environment Configuration

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=shisha_user
DB_PASSWORD=shisha_password
DB_NAME=shisha_db

# Backend
NODE_ENV=development
PORT=3000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
APP_URL=http://localhost:3000
APP_NAME=Hookah Store
ADMIN_EMAIL=muitamaxwell@gmail.com

# SMTP (Gmail example)
# Use a Google App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=muitamaxwell@gmail.com
SMTP_PASS='your-gmail-app-password'
SMTP_FROM=muitamaxwell@gmail.com

# Frontend (Public - visible in browser)
NEXT_PUBLIC_API_URL=http://localhost:3000/api
